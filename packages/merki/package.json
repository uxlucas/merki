{
  "name": "merki-icons",
  "version": "0.0.0",
  "description": "An icon library that obsesses over details. 16px icons for React, plus plain SVGs.",
  "keywords": [
    "icons",
    "icon-set",
    "react",
    "react-icons",
    "svg",
    "16px",
    "ui"
  ],
  "homepage": "https://merki.lucaslima.design",
  "bugs": {
    "url": "https://github.com/uxlucas/merki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxlucas/merki.git",
    "directory": "packages/merki"
  },
  "license": "MIT",
  "author": "Lucas Lima (https://lucaslima.design)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svg/*": "./svg/*"
  },
  "files": ["dist", "svg"],
  "scripts": {
    "build": "tsup",
    "prepack": "npm --prefix ../.. run build && node prepack.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
