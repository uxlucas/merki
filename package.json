{
  "name": "merki-repo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:icons && npm run build -w merki",
    "dev:lab": "npm run dev -w site",
    "build:icons": "tsx scripts/build.ts",
    "lint:icons": "tsx scripts/lint.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svg-path-bbox": "^2.1.0",
    "svgo": "^4.1.0",
    "svgpath": "^2.6.0",
    "svgson": "^5.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
